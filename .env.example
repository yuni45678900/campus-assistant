# 复制本文件为 .env 后按需修改；.env 不会进版本库。
#
# 两套账号，权限是包含关系：
#   学生账号 → 只能进学生端
#   管理账号 → 管理端 + 学生端都能进
CAMPUS_ADMIN_USER=admin
CAMPUS_ADMIN_PASS=change-me
CAMPUS_STUDENT_USER=student
CAMPUS_STUDENT_PASS=change-me-too

# 内置演示学生账号挂在哪个学校名下（管理端现场开的号各自带学校名，与此无关）
CAMPUS_STUDENT_SCHOOL=演示学校

# 登录态有效期（小时）
# CAMPUS_SESSION_HOURS=8
# 单文件上传上限（MB）
# CAMPUS_MAX_UPLOAD_MB=50
# 最终喂给模型的片段数
# CAMPUS_RERANK_TOP_N=3
